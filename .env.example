# Environment Variables Configuration

# Backend Configuration
EXPO_PUBLIC_WEBSOCKET_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Expo Project Configuration
# Get this from your Expo project settings
EXPO_PUBLIC_PROJECT_ID=your_expo_project_id

# SECURITY WARNING: The following are placeholders for demonstration only
# NEVER expose actual Twilio credentials in client-side code
# These should ONLY be used server-side in your backend

# Server-side only (NOT to be used in client):
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Server-side only (NOT to be used in client):
# JWT_SECRET=your_jwt_secret_key
# ENCRYPTION_MASTER_KEY=your_encryption_master_key
