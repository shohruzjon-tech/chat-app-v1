# Environment Variables Configuration

# WebSocket Server URL
EXPO_PUBLIC_WEBSOCKET_URL=http://localhost:3000

# Twilio Configuration (for SMS authentication)
# Note: These should NEVER be exposed in client-side code
# The values below are placeholders - implement server-side authentication
EXPO_PUBLIC_TWILIO_ACCOUNT_SID=your_twilio_account_sid
EXPO_PUBLIC_TWILIO_AUTH_TOKEN=your_twilio_auth_token
EXPO_PUBLIC_TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Encryption Key (for end-to-end encryption)
EXPO_PUBLIC_ENCRYPTION_KEY=your_secret_encryption_key

# Expo Project ID (for push notifications)
EXPO_PUBLIC_PROJECT_ID=your_expo_project_id

# Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:3000/api
